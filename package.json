{
  "name": "inspeccion-postsismica-cali",
  "version": "0.1.0",
  "description": "Captura del Formulario Único AIS y coordinación de inspecciones post-sísmicas en Cali",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace api",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "backend:dev": "npm run start:dev --workspace backend",
    "backend:build": "npm run build --workspace backend",
    "backend:seed": "npm run db:seed --workspace backend",
    "worker": "npm run worker --workspace api",
    "test": "node --test api/test/**/*.test.js shared/**/*.test.js",
    "db:schema": "psql $DATABASE_URL -f db/schema.sql",
    "db:seed": "psql $DATABASE_URL -f db/seed.sql",
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "postgres": "^3.4.5",
    "argon2": "^0.41.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "resend": "^4.0.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "vite": "^6.0.5"
  }
}
