# Dev: proxy Vite → backend :3001 (PC y móvil en la misma red). Default si no defines nada.
VITE_API_BASE=/api/v1

# Vite usa HTTPS en dev (@vitejs/plugin-basic-ssl) para GPS en el celular.
# Abre https://TU_IP_LAN:5173 desde el móvil (ej. 192.168.x.x) y acepta el certificado.

# NO uses localhost en .env.development si pruebas desde el celular:
# VITE_API_BASE=http://localhost:3001/api/v1
