# ============================================================
# Backend NestJS — copia a backend/.env
# ============================================================

NODE_ENV=development
PORT=3001
URL_BASE=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# --- MySQL ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cali_inspeccion
# Solo desarrollo: TypeORM crea tablas automáticamente
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- JWT -----------------------------------------------------
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Auth (legacy api) ---------------------------------------
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15
TICKET_FIRMA_TTL_MINUTOS=5

# --- Operación -----------------------------------------------
MAX_FOTOS_POR_REPORTE=100
# Desarrollo: sube el límite (prod suele ser 3). 0 = sin límite en POST /reportes
RATE_REPORTES_POR_HORA_IP=100
RATE_ESTADO_POR_HORA_IP=60
RATE_FOTOS_POR_HORA_IP=200

# Mapa público: en prod solo reportes validados+. En dev puedes usar true para pruebas.
MAPA_INCLUIR_NUEVO=false

UPLOAD_DIR=uploads
MAX_BYTES_FOTO_FULL=4194304
MAX_BYTES_FOTO_THUMB=524288

# --- Correo (Resend, API HTTPS) --------------------------------------
# Sin RESEND_API_KEY el enlace se imprime en los logs del backend (desarrollo).
RESEND_API_KEY=
CORREO_REMITENTE=no-responder@ejemplo.co
